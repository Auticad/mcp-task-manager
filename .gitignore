# ── Ambiente virtuale Python ──────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Runtime MCP ───────────────────────────────────────────────
# Database SQLite generato automaticamente al primo avvio
tasks.db

# ── Bytecode Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Distribuzione e packaging ─────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── uv ────────────────────────────────────────────────────────
# uv.lock va versionato (è il lock file delle dipendenze)
# .python-version può essere utile tenerlo, ma dipende dal setup
.python-version

# ── Variabili d'ambiente e segreti ────────────────────────────
.env
.env.local
.env.*.local

# ── Editor e IDE ──────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Log ───────────────────────────────────────────────────────
*.log

# ── Coverage e test ───────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
